# Copy to .env (gitignored) and fill in. NEVER commit real secrets.

# --- Server / deploy target ---
DEPLOY_HOST=your.server.ip.or.host
DEPLOY_USER=root
DEPLOY_PASS=
REMOTE_INDEX_PATH=/var/www/app/index.html
REMOTE_PROXY_PATH=/var/www/proxy.js

# --- Third-party API keys (used by the proxy, server-side ONLY) ---
ANTHROPIC_KEY=

# --- Platform connections (see INTEGRATIONS.md §4/§14; frontend/connect.html) ---
# Spotify: Client Credentials (app-only, no user login) — public artist metadata only,
# the Web API has never exposed real stream counts to anyone. Create a free app at
# developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=
# YouTube: Data API v3 key (public channel stats, no login) — create at
# console.cloud.google.com, enable "YouTube Data API v3", make an API key.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# YouTube Analytics: real OAuth2 (needs a one-time consent click from whoever owns the
# channel) — same Google Cloud project as above, but an OAuth 2.0 Client ID (Web
# application type), with YT_OAUTH_REDIRECT_URI added to its authorized redirect URIs
# exactly as the value below (this proxy's own /api/youtube-analytics/callback route).
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REDIRECT_URI=https://your-proxy-host/api/youtube-analytics/callback
# Where the OAuth callback redirects back to after connecting (frontend/connect.html).
CONNECT_PAGE_URL=https://moishsonn-tech.github.io/oooh-my-hat/connect.html

# --- Multi-artist accounts (Supabase Auth + Postgres — see supabase/schema.sql) ---
# Self-serve artist signup/login, so each artist connects their own platforms instead
# of everything living in the one shared STATE_FILE blob above. NOT YET LIVE: run
# supabase/schema.sql in a real Supabase project's SQL editor, then fill these in —
# every route in backend/proxy.js falls back to today's single-tenant behavior
# automatically while these are blank, so leaving them empty is always safe.
# service_role key — server-side ONLY, bypasses row-level security. Project Settings
# → API → service_role (NOT the anon key — that one goes in frontend/supabase-config.js,
# it's meant to be public).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email sending (see INTEGRATIONS.md §1; fill only what you use) ---
# HTTPS mail relay (Apps Script web app) — primary channel for servers (VPS block SMTP ports)
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
# Gmail SMTP app password — for machines that CAN reach SMTP (requires 2-Step Verification on)
SMTP_USER=
SMTP_APP_PASSWORD=
# EmailJS — FALLBACK ONLY (free-tier quota exhausts)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# --- Payments (Stripe; secret key server-side ONLY, see INTEGRATIONS.md §3) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App config ---
# The GitHub Pages origin this is deployed to (CORS is locked to exactly this, not *).
APP_ORIGIN=https://moishsonn-tech.github.io

# --- Local runtime state (PIN hash, YouTube Analytics refresh token, manual-platform
# credentials) — encrypted at rest by proxy.js ---
# NOTE: on Render's free tier this disk does NOT persist across redeploys — a redeploy
# resets the PIN back to DEFAULT_PIN, disconnects YouTube Analytics (needs re-consenting),
# and clears any saved 24Six/Zing/Naki credentials (need re-entering on connect.html).
# Known/accepted tradeoff for now (see CLAUDE.md). Once SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY
# above are filled in, per-artist platform connections move to Supabase Postgres instead
# (real persistence, survives redeploys) — this blob then only matters for the PIN.
STATE_FILE=./data/state.json
STATE_KEY_FILE=./data/.state-key

# --- Dashboard access PIN ---
# Seeds the PIN the first time the server runs (only used if no PIN has been set yet).
DEFAULT_PIN=234
# Pepper for hashing the PIN at rest — set a real random value before this ever runs
# somewhere real; the default below is a placeholder, not a secret.
PIN_SALT=change-me-this-is-a-placeholder-salt
# NOT YET ENFORCED: /api/pin/change is temporarily open to anyone (see backend/proxy.js).
# Fill this in with Benny's real email and wire verifyIdToken() before this goes live.
ADMIN_EMAIL_ALLOWLIST=<benny@REPLACE_ME.example>
